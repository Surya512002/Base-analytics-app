# ── Public (client-safe) ──────────────────────────────────────────
# Canonical app URL for OG images, share links, and metadata
NEXT_PUBLIC_APP_URL=https://base-analytics-app.vercel.app
# Alchemy — used ONLY after user unlocks full onchain analysis (server + optional public)
# Prefer ALCHEMY_API_KEY (server). NEXT_PUBLIC_ALCHEMY_KEY is a fallback for legacy paths.
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_BUILDER_CODE=bc_4uoh9iu2
NEXT_PUBLIC_PAYMASTER_URL=
NEXT_PUBLIC_CDP_API_KEY=
NEXT_PUBLIC_VOUCHER_CONTRACT=
# Shared-link vouchers (one link, first N claim). Empty = feature shows "not live yet".
NEXT_PUBLIC_CAMPAIGN_CONTRACT=
# SERVER ONLY. Key of a dedicated zero-balance wallet that signs claim tickets. Never reuse a funded wallet.
# Its address is published via /api/voucher/campaign/config.
CAMPAIGN_CLAIM_SIGNER_KEY=

# ── Drops (BaseDrops contract, docs/DROPS_DESIGN.md) ─────────────────
# BaseDrops address once deployed (APIs answer 503 until set).
NEXT_PUBLIC_DROPS_CONTRACT=
# TokenBalanceGate address (enables "token holders" drops).
NEXT_PUBLIC_DROPS_TOKEN_GATE=
# Block BaseDrops was deployed at; My drops scans creator events from here.
NEXT_PUBLIC_DROPS_DEPLOY_BLOCK=
# Preview/staging only: 84532 runs Drops on Base Sepolia (leave unset in production = mainnet).
NEXT_PUBLIC_DROPS_CHAIN_ID=
# Optional Base Sepolia RPC for Drops in testnet mode (default https://sepolia.base.org).
NEXT_PUBLIC_DROPS_RPC_URL=

# ── Linked accounts for drop tasks (all optional; each platform turns on when set) ──
# X app (developer.x.com, OAuth 2.0, confidential client). Callback: <APP_URL>/api/accounts/x/callback
X_CLIENT_ID=
# Keep server-side only.
X_CLIENT_SECRET=
# Discord app (discord.com/developers). OAuth2 redirect: <APP_URL>/api/accounts/discord/callback
DISCORD_CLIENT_ID=
# Keep server-side only.
DISCORD_CLIENT_SECRET=
# Bot token of the same Discord app; creators add this bot to their server to verify membership.
DISCORD_BOT_TOKEN=
# Telegram bot from @BotFather (also run /setdomain with your app domain for login).
TELEGRAM_BOT_TOKEN=
# Bot username without @, shown to creators.
TELEGRAM_BOT_USERNAME=
# SERVER ONLY. Dedicated zero-balance key that signs drop tickets after tasks pass; its address
# is shown at /api/drops/catalog and goes in a drop's ticketSigner. Separate from the campaign key.
DROPS_TICKET_SIGNER_KEY=

# ── Launchpad (B20 + trading terminal) ─────────────────────────────
LAUNCHPAD_PLATFORM_FEE_BPS=25
NEXT_PUBLIC_LAUNCHPAD_PLATFORM_FEE_BPS=25
# Fee split of platform fee: creator / platform / referrer (must sum to 10000)
LAUNCHPAD_FEE_SHARE_CREATOR_BPS=6000
LAUNCHPAD_FEE_SHARE_PLATFORM_BPS=2000
LAUNCHPAD_FEE_SHARE_REFERRER_BPS=2000
# SIWE sign-in session signing (set in production)
SIWE_SESSION_SECRET=
# Encrypts saved gift-card claim links at rest (set in production): openssl rand -base64 32
VOUCHER_SECRETS_KEY=
# To rotate: put the old value here (comma-separated), then set a new VOUCHER_SECRETS_KEY.
VOUCHER_SECRETS_KEY_PREVIOUS=
LAUNCHPAD_TREASURY=
NEXT_PUBLIC_LAUNCHPAD_TREASURY=

# Optional on-chain extensions
NEXT_PUBLIC_XP_STAKE_CONTRACT=
NEXT_PUBLIC_BADGE_MARKETPLACE_CONTRACT=

# Treasury / fees (default in code: 0xB4BD7D410543cB27f42c562ab3fF5DC12fBDd42F)
BASESCAN_API_KEY=
BASESCAN_API_KEYS=
NEYNAR_API_KEY=
# 0x Swap API v2 key (https://dashboard.0x.org) — enables aggregator fallback
# so tokens without a direct WETH pool (USDC pairs, multi-hop) swap in-app
ZEROX_API_KEY=

# Redis — required on Vercel for fast wallet reconnects, leaderboard, vouchers
# Redis Cloud: rediss://default:PASSWORD@host:PORT
KV_REDIS_URL=

# MCP voucher tools (optional — require Authorization: Bearer <key>)
MCP_API_KEY=

# Base App notifications (https://docs.base.org/apps/technical-guides/base-notifications)
BASE_DASHBOARD_API_KEY=
BASE_APP_REGISTERED_URL=https://base-analytics-app.vercel.app
BASE_NOTIFICATIONS_ADMIN_SECRET=

# Base RPC (optional — defaults to public Base mainnet)
BASE_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# x402 premium scan facilitator (server wallet)
X402_FACILITATOR_PRIVATE_KEY=

# Cron auth for /api/cron/price-alerts (Vercel sends Authorization: Bearer <secret>)
CRON_SECRET=
