# ── Public (client-safe) ──────────────────────────────────────────
# Canonical app URL for OG images, share links, and metadata
NEXT_PUBLIC_APP_URL=https://base-analytics-app.vercel.app
# Single Alchemy key (server + client)
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_KEY=
NEXT_PUBLIC_BUILDER_CODE=bc_4uoh9iu2
NEXT_PUBLIC_PAYMASTER_URL=
NEXT_PUBLIC_CDP_API_KEY=
NEXT_PUBLIC_VOUCHER_CONTRACT=

# ── Launchpad (B20 + trading terminal) ─────────────────────────────
LAUNCHPAD_PLATFORM_FEE_BPS=25
NEXT_PUBLIC_LAUNCHPAD_PLATFORM_FEE_BPS=25
# Fee split of platform fee: creator / platform / referrer (must sum to 10000)
LAUNCHPAD_FEE_SHARE_CREATOR_BPS=6000
LAUNCHPAD_FEE_SHARE_PLATFORM_BPS=2000
LAUNCHPAD_FEE_SHARE_REFERRER_BPS=2000
# SIWE sign-in session signing (set in production)
SIWE_SESSION_SECRET=
LAUNCHPAD_TREASURY=
NEXT_PUBLIC_LAUNCHPAD_TREASURY=

# Optional on-chain extensions
NEXT_PUBLIC_XP_STAKE_CONTRACT=
NEXT_PUBLIC_BADGE_MARKETPLACE_CONTRACT=

# Treasury / fees (default in code: 0xB4BD7D410543cB27f42c562ab3fF5DC12fBDd42F)
BASESCAN_API_KEY=
BASESCAN_API_KEYS=
NEYNAR_API_KEY=
# 0x Swap API v2 key (https://dashboard.0x.org) — enables aggregator fallback
# so tokens without a direct WETH pool (USDC pairs, multi-hop) swap in-app
ZEROX_API_KEY=

# Redis — required on Vercel for fast wallet reconnects, leaderboard, vouchers
# Redis Cloud: rediss://default:PASSWORD@host:PORT
KV_REDIS_URL=

# MCP voucher tools (optional — require Authorization: Bearer <key>)
MCP_API_KEY=

# Base App notifications (https://docs.base.org/apps/technical-guides/base-notifications)
BASE_DASHBOARD_API_KEY=
BASE_APP_REGISTERED_URL=https://base-analytics-app.vercel.app
BASE_NOTIFICATIONS_ADMIN_SECRET=

# Base RPC (optional — defaults to public Base mainnet)
BASE_RPC_URL=
NEXT_PUBLIC_BASE_RPC_URL=

# x402 premium scan facilitator (server wallet)
X402_FACILITATOR_PRIVATE_KEY=

# Cron auth for /api/cron/price-alerts (Vercel sends Authorization: Bearer <secret>)
CRON_SECRET=
