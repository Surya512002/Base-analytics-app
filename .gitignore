# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
coverage/
/test-results/
/playwright-report/

# next.js
/.next/
.next/
/out/
out/
/dist/
dist/

# production & build output
/build
build/
/forge-out/
forge-out/
/cache/
.cache/
/broadcast/
broadcast/
.anvil/

# misc
.DS_Store
*.pem
*.key
.cursor/
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env*
.env.*
!.env.example

# vercel
.vercel/
.vercel

# local keystores & test output
*.keystore
*.keystore.json
keystores/
.playwright/

# typescript
*.tsbuildinfo
next-env.d.ts
