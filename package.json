{
  "name": "base-analytics-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:collector && next build",
    "build:collector": "node scripts/build-collector.mjs",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots:dashboard": "PLAYWRIGHT_SKIP_SERVER=1 SCREENSHOT_BASE_URL=https://base-analytics-app.vercel.app playwright test e2e/capture-dashboard-screenshots.spec.ts",
    "thumbnail:generate": "node scripts/generate-app-thumbnail.mjs --local",
    "thumbnail:generate:prod": "node scripts/generate-app-thumbnail.mjs",
    "test:swap-routes": "node scripts/test-swap-routes.mjs",
    "test:swap-routes:local": "node scripts/test-swap-routes.mjs --local",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:gitleaks": "docker run --rm -v \"$PWD:/repo\" zricethezav/gitleaks:latest detect --source /repo || node scripts/scan-secrets.mjs",
    "contracts:build": "forge build || echo 'Foundry not installed locally — verified in GitHub Actions'",
    "contracts:test": "forge test -vvv || npx vitest run lib/contracts/",
    "contracts:coverage": "forge coverage || echo 'Foundry coverage runs in GitHub Actions'",
    "contracts:slither": "slither . || echo 'Slither static analysis runs in GitHub Actions'",
    "contracts:deploy:dry-run": "node scripts/deploy-contracts.mjs --dry-run",
    "test:fork": "vitest run test/fork/mainnet-fork.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run audit && npm run secrets:scan && npm test && npm run test:fork",
    "registry:sync": "node scripts/sync-stock-registry.mjs",
    "voucher:deploy": "bash scripts/deploy-and-verify-voucher.sh",
    "stake:deploy": "bash scripts/deploy-stake-market.sh",
    "notify:list": "node scripts/send-base-notification.mjs list",
    "notify:b20": "node scripts/send-base-notification.mjs broadcast --preset b20_launch",
    "logos:seed": "node scripts/seed-token-logos.mjs",
    "logos:audit": "node scripts/audit-token-logos.mjs"
  },
  "dependencies": {
    "@base-org/account": "^2.5.13",
    "@coinbase/cdp-sdk": "^1.44.1",
    "@coinbase/onchainkit": "^1.1.3",
    "@farcaster/miniapp-node": "^0.2.0",
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@farcaster/miniapp-wagmi-connector": "^2.0.0",
    "@farcaster/quick-auth": "^0.0.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@neynar/nodejs-sdk": "^3.177.0",
    "@neynar/react": "^1.2.22",
    "@tanstack/react-query": "^5.104.4",
    "@vercel/kv": "^3.0.0",
    "@x402/core": "^2.28.0",
    "@x402/evm": "^2.28.0",
    "@x402/next": "^2.28.0",
    "axios": "^1.13.4",
    "ethers": "^6.17.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.59.0",
    "mcp-handler": "^2.3.0",
    "motion": "^14.3.1",
    "next": "^16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "siwe": "^3.0.0",
    "viem": "^2.57.7",
    "wagmi": "^3.7.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/connect": "^3.4.38",
    "@types/estree": "^1.0.9",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trusted-types": "^2.0.7",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.0.5"
  }
}
