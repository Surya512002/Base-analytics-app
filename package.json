{
  "name": "base-analytics-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:collector && next build",
    "build:collector": "if command -v go >/dev/null 2>&1; then cd collector && go build -o collector .; else echo 'Skipping Go collector (go not installed — wallet sync uses JS fallback)'; fi",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screenshots:dashboard": "PLAYWRIGHT_SKIP_SERVER=1 SCREENSHOT_BASE_URL=https://base-analytics-app.vercel.app playwright test e2e/capture-dashboard-screenshots.spec.ts",
    "thumbnail:generate": "node scripts/generate-app-thumbnail.mjs --local",
    "thumbnail:generate:prod": "node scripts/generate-app-thumbnail.mjs",
    "test:swap-routes": "node scripts/test-swap-routes.mjs",
    "test:swap-routes:local": "node scripts/test-swap-routes.mjs --local",
    "typecheck": "tsc --noEmit",
    "voucher:deploy": "bash scripts/deploy-and-verify-voucher.sh",
    "stake:deploy": "bash scripts/deploy-stake-market.sh",
    "notify:list": "node scripts/send-base-notification.mjs list",
    "notify:b20": "node scripts/send-base-notification.mjs broadcast --preset b20_launch"
  },
  "dependencies": {
    "@base-org/account": "^2.5.4",
    "@coinbase/cdp-sdk": "^1.44.1",
    "@coinbase/onchainkit": "^1.1.2",
    "@farcaster/miniapp-node": "^0.2.0",
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@farcaster/miniapp-wagmi-connector": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@neynar/nodejs-sdk": "^3.131.0",
    "@neynar/react": "^1.2.22",
    "@tanstack/react-query": "^5.99.0",
    "@vercel/kv": "^3.0.0",
    "@x402/core": "^2.16.0",
    "@x402/evm": "^2.16.0",
    "@x402/next": "^2.16.0",
    "axios": "^1.13.4",
    "ethers": "^6.16.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.563.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "viem": "^2.53.1",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/connect": "^3.4.38",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trusted-types": "^2.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
