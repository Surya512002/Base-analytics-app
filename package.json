{
  "name": "base-analytics-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:collector && next build",
    "build:collector": "command -v go >/dev/null 2>&1 && cd collector && go build -o collector . || echo 'Skipping Go collector (go not installed)'",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "start": "next start",
    "lint": "eslint",
    "voucher:deploy": "bash scripts/deploy-and-verify-voucher.sh"
  },
  "dependencies": {
    "@base-org/account": "^2.5.4",
    "@coinbase/cdp-sdk": "^1.44.1",
    "@coinbase/onchainkit": "^1.1.2",
    "@farcaster/miniapp-sdk": "^0.3.0",
    "@farcaster/miniapp-wagmi-connector": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@neynar/nodejs-sdk": "^3.131.0",
    "@neynar/react": "^1.2.22",
    "@pigment-css/react": "^0.0.30",
    "@tanstack/react-query": "^5.99.0",
    "@vercel/kv": "^3.0.0",
    "@x402/core": "^2.16.0",
    "@x402/evm": "^2.16.0",
    "@x402/next": "^2.16.0",
    "axios": "^1.13.4",
    "ethers": "^6.16.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.563.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "viem": "^2.53.1",
    "wagmi": "^2.19.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/connect": "^3.4.38",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trusted-types": "^2.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
