{
  "name": "base-analytics-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run build:collector && node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "build:collector": "node scripts/build-collector.mjs",
    "dev": "next dev --webpack",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "rm -rf .next && next dev --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:e2e": "playwright test",
    "screenshots:dashboard": "PLAYWRIGHT_SKIP_SERVER=1 SCREENSHOT_BASE_URL=https://base-analytics-app.vercel.app playwright test e2e/capture-dashboard-screenshots.spec.ts",
    "thumbnail:generate": "node scripts/generate-app-thumbnail.mjs --local",
    "thumbnail:generate:prod": "node scripts/generate-app-thumbnail.mjs",
    "test:swap-routes": "node scripts/test-swap-routes.mjs",
    "test:swap-routes:local": "node scripts/test-swap-routes.mjs --local",
    "typecheck": "node --max-semi-space-size=128 --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "secrets:gitleaks": "docker run --rm -v \"$PWD:/repo\" zricethezav/gitleaks:latest detect --source /repo || node scripts/scan-secrets.mjs",
    "contracts:build": "forge build || echo 'Foundry not installed locally — verified in GitHub Actions'",
    "contracts:test": "forge test -vvv || npx vitest run lib/contracts/",
    "contracts:coverage": "forge coverage || echo 'Foundry coverage runs in GitHub Actions'",
    "contracts:slither": "slither . || echo 'Slither static analysis runs in GitHub Actions'",
    "contracts:deploy:dry-run": "node scripts/deploy-contracts.mjs --dry-run",
    "test:fork": "vitest run --config vitest.fork.config.ts",
    "verify": "npm run typecheck && npm run lint && npm run audit && npm run secrets:scan && npm test && npm run test:fork",
    "registry:sync": "node scripts/sync-stock-registry.mjs",
    "stocks:sync": "node scripts/sync-live-stocks.mjs",
    "voucher:deploy": "bash scripts/deploy-and-verify-voucher.sh",
    "notify:list": "node scripts/send-base-notification.mjs list",
    "notify:b20": "node scripts/send-base-notification.mjs broadcast --preset b20_launch",
    "logos:seed": "node scripts/seed-token-logos.mjs",
    "logos:audit": "node scripts/audit-token-logos.mjs",
    "portfolio:compare": "node scripts/portfolio-compare.mjs",
    "drops:preflight": "node scripts/drops-preflight.mjs",
    "redis:usage": "node scripts/redis-usage.mjs",
    "redis:shrink-media": "node scripts/redis-shrink-media.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.62.0",
    "proxy-addr": "^2.0.8",
    "@hono/node-server": "^1.19.19",
    "body-parser": "^2.4.0",
    "fast-uri": "^3.1.9",
    "hono": "^4.13.20",
    "ip-address": "^10.7.6",
    "qs": "^6.17.1"
  },
  "dependencies": {
    "@base-org/account": "2.6.0",
    "@coinbase/cdp-sdk": "1.62.0",
    "@farcaster/miniapp-node": "^0.2.1",
    "@farcaster/miniapp-sdk": "^0.4.0",
    "@farcaster/quick-auth": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@neynar/nodejs-sdk": "^3.177.0",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/kv": "^3.0.0",
    "@x402/core": "^2.31.0",
    "@x402/evm": "^2.31.0",
    "@x402/next": "^2.31.0",
    "axios": "^1.21.1",
    "ethers": "6.17.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.577.0",
    "mcp-handler": "^1.1.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.5",
    "siwe": "2.3.2",
    "viem": "2.57.19",
    "wagmi": "^3.7.11",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/connect": "^3.4.38",
    "@types/estree": "^1.0.10",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.39",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/trusted-types": "^2.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.64.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
